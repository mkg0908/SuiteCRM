# Render deployment configuration example
# Copy and adapt for your Render service

services:
  - type: web
    name: caseflow
    runtime: docker
    dockerfilePath: ./modern/Dockerfile
    dockerContext: ./modern
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: caseflow-db
          property: connectionString
      - key: SESSION_SECRET
        generateValue: true
      - key: NODE_ENV
        value: production
      - key: LOG_LEVEL
        value: info
      # Optional LLM key - add manually in Render dashboard
      # - key: LLM_API_KEY
      #   sync: false
    healthCheckPath: /healthz
    autoDeploy: false

databases:
  - name: caseflow-db
    databaseName: caseflow
    plan: starter
