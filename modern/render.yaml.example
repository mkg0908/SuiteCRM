services:
  - type: web
    name: caseflow
    runtime: docker
    dockerfilePath: ./modern/Dockerfile
    dockerContext: ./modern
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: caseflow-db
          property: connectionString
      - key: SESSION_SECRET
        generateValue: true
      - key: NODE_ENV
        value: production
      - key: LOG_LEVEL
        value: info

databases:
  - name: caseflow-db
    plan: starter
