# CaseFlow Environment Variables
# Copy this file to .env for local development
# NEVER commit .env with real values

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/caseflow

# Required: Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production

# Required: Node environment
NODE_ENV=development

# Optional: Log level (error, warn, info, debug)
LOG_LEVEL=info

# Optional: LLM API key for draft reply generation
# LLM_API_KEY=sk-...

# Optional: Port (default: 3000)
PORT=3000
